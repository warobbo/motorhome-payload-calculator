# Copy to .env for local `npm start`. Do not commit real keys.
# The public calculator does not read these. Demo plates and the catalogue
# run in the browser. A key stored with /?setup=1 is sent to DVLA from that browser.
DVLA_API_KEY=
MOT_API_KEY=

# Local verification only. The launch helper sets this to run/missing-sizes.jsonl.
MISSING_SIZE_LOG_PATH=

# Static-site build. When set, scripts/publish-public.sh writes it into
# public/site-config.js. Leave unset locally; the page posts to /api/missing-size.
MISSING_SIZE_ENDPOINT=

# Worker only. If MISSING_SIZE_NOTIFY_URL is unset, the Worker logs the note
# and does not call out. The HTTP response never includes these values.
# MISSING_SIZE_NOTIFY_URL=
# MISSING_SIZE_NOTIFY_EMAIL=
