# Copy to .env for local `npm start`. Do not commit real keys.
# The Node service reads these names. The Worker uses the same names as
# secrets (`npx wrangler secret put DVLA_API_KEY`). The published pages
# do not contain the values. Demo plates and the catalogue still run
# without a key.
DVLA_API_KEY=
MOT_API_KEY=

# Local verification only. The launch helper sets this to run/missing-sizes.jsonl.
MISSING_SIZE_LOG_PATH=

# Static-site build. When either is set, scripts/publish-public.sh writes
# both into public/site-config.js. Leave unset locally; the page uses
# /api/missing-size and /api/vehicle-lookup.
MISSING_SIZE_ENDPOINT=
VEHICLE_LOOKUP_ENDPOINT=

# Worker only. If MISSING_SIZE_NOTIFY_URL is unset, the Worker logs the note
# and does not call out. The HTTP response never includes these values.
# MISSING_SIZE_NOTIFY_URL=
# MISSING_SIZE_NOTIFY_EMAIL=
