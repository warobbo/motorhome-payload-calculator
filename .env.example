# Copy to .env for local `npm start`. Do not commit real keys.
# On Render: Dashboard → web service → Environment → add these, then save.
DVLA_API_KEY=
MOT_API_KEY=

# Optional. Public contact used only for the missing-size mailto fallback.
# If unset, the form still posts to /api/missing-size (Render logs).
MISSING_SIZE_NOTIFY_EMAIL=

# Optional. JSONL path if you attach a Render disk. Leave blank to log to
# stdout only on Render (the filesystem is ephemeral).
MISSING_SIZE_LOG_PATH=
